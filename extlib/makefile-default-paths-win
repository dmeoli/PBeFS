###############################################################################
######################### makefile-default-paths-win ##########################
###############################################################################
#                                                                             #
#   default paths of the external libraries on Windows, in MSYS2              #
#                                                                             #
#   Gives the macros of the directories of the external libraries that the    #
#   makefiles need, set to where they usually are; each one is set only if    #
#   it is not set already, on the command line or in the environment, and     #
#   makefile-paths, next to this file and ignored by git, may set it          #
#   otherwise for the libraries that are somewhere else.                      #
#                                                                             #
#   Output: $(FF_ROOT)    = the directory of the ff/ headers of FastFlow,     #
#                           empty for none                                    #
#           $(ADSSDR)     = the directory of ADS (its headers in include/)    #
#           $(BOOST_ROOT) = the prefix of Boost (its headers in include/)     #
#           $(HWY_ROOT)   = the prefix of Highway, optional                   #
#           $(HWLOC_ROOT) = the prefix of hwloc, optional                     #
#           $(OMP_ROOT)   = the prefix of the OpenMP runtime of clang,        #
#                           empty when the compiler finds it alone            #
#           $(SYLVAN_ROOT) = the prefix of Sylvan and Lace, optional          #
#           $(OMP_SW)     = the switches that compile OpenMP                  #
#           $(OMP_LIB)    = the switches that link its runtime                #
#           $(PBeFSSTATIC) = 1, i.e., the static library [see makefile-lib]   #
#           $(SO_EXT)     = the extension of a shared library                 #
#           $(SO_SW)      = the switches that link the shared library $(1)    #
#           $(RPATH_SW)   = the switches that make a program look for the     #
#                           shared libraries in the directory $(1)            #
#                                                                             #
#                                Donato Meoli                                 #
#                         Dipartimento di Informatica                         #
#                             Università di Pisa                              #
#                                                                             #
###############################################################################

# no FastFlow, which relies on POSIX
FF_ROOT ?=
ADSSDR ?= C:/ADS
BOOST_ROOT ?= $(MINGW_PREFIX)
HWY_ROOT ?= $(MINGW_PREFIX)
HWLOC_ROOT ?= $(MINGW_PREFIX)
OMP_ROOT ?=
SYLVAN_ROOT ?= C:/sylvan
OMP_SW ?= -fopenmp $(if $(OMP_ROOT),-I$(OMP_ROOT)/include)
OMP_LIB ?= -fopenmp $(if $(OMP_ROOT),-L$(OMP_ROOT)/lib)

# the library is static: a DLL is found only next to the program or on the
# PATH, as there is no run-time path
PBeFSSTATIC ?= 1
SO_EXT ?= dll
SO_SW ?= -shared
RPATH_SW ?=

###################### End of makefile-default-paths-win ######################
