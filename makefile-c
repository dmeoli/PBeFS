###############################################################################
################################# makefile-c ##################################
###############################################################################
#                                                                             #
#   complete makefile of PBeFS                                                #
#                                                                             #
#   The makefile defines internally all the external libraries required by    #
#   the parallel runtimes of PBeFS: the threads, OpenMP and the headers of    #
#   FastFlow, if $(FF_ROOT) is not empty. MPI is not here: what includes      #
#   HDAStarMPI.h is compiled with mpicxx. The places of the libraries and     #
#   the switches of OpenMP are those of extlib/makefile-default-paths-<p>,    #
#   with <p> = $(PBeFSPLATFORM), linux unless it is given as macos or win,    #
#   and extlib/makefile-paths (ignored by git) or the command line may set    #
#   them otherwise. Sylvan, for the symbolic searches, is taken if it is      #
#   installed in $(SYLVAN_ROOT), and their object and libraries are then in   #
#   $(PBeFSSYMOBJ) and $(PBeFSSYMLIB), for the programs that use them.        #
#   Highway, hwloc and Boost, backends of ADS, are taken where they are.      #
#   Accordingly, all necessary H, -I directives and external libraries are    #
#   added to the corresponding PBeFS* macros.                                 #
#                                                                             #
#   Input:  $(CC)          = compiler command                                 #
#           $(SW)          = compiler options                                 #
#           $(PBeFSSDR)    = the directory where PBeFS is                     #
#           $(PBeFSSTRUCT) = the data structures of A*: std or boost, none    #
#                            (or ads) for those of ADS                        #
#           $(SYLVAN_ROOT) = the prefix where Sylvan is installed, if any     #
#           $(PBeFSPLATFORM) = linux (default), macos or win, the file of     #
#                            the default places of the libraries              #
#                                                                             #
#   Output: $(PBeFSOBJ)    = the final object(s) / library                    #
#           $(PBeFSLIB)    = external libraries + -L< libdirs >               #
#           $(PBeFSH)      = the .h files to include                          #
#           $(PBeFSINC)    = the -I$( include directories )                   #
#           $(PBeFSDEF)    = the -D of the runtimes that are there, and the   #
#                            switches that compiling them needs               #
#                                                                             #
#                                Donato Meoli                                 #
#                         Dipartimento di Informatica                         #
#                             Università di Pisa                              #
#                                                                             #
###############################################################################

# the places of the external libraries- - - - - - - - - - - - - - - - - - - -
# those given in makefile-paths (optional, and ignored by git) first, then
# the defaults of the platform named by $(PBeFSPLATFORM) for the others

-include $(PBeFSSDR)/extlib/makefile-paths

PBeFSPLATFORM ?= linux
include $(PBeFSSDR)/extlib/makefile-default-paths-$(PBeFSPLATFORM)

# include the makefile of the library - - - - - - - - - - - - - - - - - - - -

include $(PBeFSSDR)/makefile

# the external libraries- - - - - - - - - - - - - - - - - - - - - - - - - - -

# OpenMP: the switches of the file of the platform, $(OMP_SW) to compile
# and $(OMP_LIB) to link
PBeFSOMPSW = $(OMP_SW)
PBeFSOMPLIB = $(OMP_LIB)

# FastFlow: its headers only, as system headers, so that their warnings do
# not drown ours, if $(FF_ROOT) is not empty
ifneq ($(FF_ROOT),)
    PBeFSFFINC = -isystem $(FF_ROOT)
    PBeFSFFDEF = -DPBEFS_HAS_FASTFLOW -DADS_WITH_FASTFLOW -DNO_DEFAULT_MAPPING
endif

# Boost, for the data structures of Boost: its headers, unless they are
# among those of the system
ifeq ($(PBeFSSTRUCT),boost)
ifneq ($(BOOST_ROOT),/usr)
    PBeFSBOOSTINC = -isystem $(BOOST_ROOT)/include
endif
endif

# the backends of ADS that the searches gain from, each taken if the program
# of extlib/ads-backends.cpp for it compiles and links [see the README, "The
# data structures"]: Highway in $(HWY_ROOT), for the prefetch of CLOSED and
# the vectors of FlatHashTable, hwloc in $(HWLOC_ROOT), for the placement
# of the workers by PBEFS_PIN, and the headers of Boost 1.83 or later in
# $(BOOST_ROOT), for the boost::unordered_flat_map of the FlatHashTable of
# the searches with external memory (CLOSED stays the PointerTable of ADS
# [see makefile])
PBeFSTRY = $(PBeFSSDR)/obj/ads-try
PBeFStry = $(shell $(CC) -std=c++20 -DPBEFS_TRY_$(1) \
	$(PBeFSSDR)/extlib/ads-backends.cpp -o $(PBeFSTRY) $(2) 2>/dev/null && \
	echo 1; rm -f $(PBeFSTRY) $(PBeFSTRY).exe)
PBeFSsys = $(if $(filter-out /usr,$(1)),-isystem $(1)/include)
PBeFSlib = $(if $(filter-out /usr,$(1)),-L$(1)/lib)

PBeFSHWYLIB = $(call PBeFSlib,$(HWY_ROOT)) -lhwy_contrib -lhwy
ifeq ($(call PBeFStry,HIGHWAY,$(call PBeFSsys,$(HWY_ROOT)) $(PBeFSHWYLIB)),1)
    PBeFSADSINC += -DADS_WITH_HIGHWAY $(call PBeFSsys,$(HWY_ROOT))
    PBeFSADSLIB += $(PBeFSHWYLIB)
endif

PBeFSHWLOCLIB = $(call PBeFSlib,$(HWLOC_ROOT)) -lhwloc
ifeq ($(call PBeFStry,HWLOC,$(call PBeFSsys,$(HWLOC_ROOT)) \
	$(PBeFSHWLOCLIB)),1)
    PBeFSADSINC += -DADS_WITH_HWLOC $(call PBeFSsys,$(HWLOC_ROOT))
    PBeFSADSLIB += $(PBeFSHWLOCLIB)
endif

ifeq ($(call PBeFStry,BOOST,$(call PBeFSsys,$(BOOST_ROOT))),1)
    PBeFSADSINC += -DADS_FLATHASH_BOOST=1
    ifneq ($(PBeFSSTRUCT),boost)
        PBeFSADSINC += $(call PBeFSsys,$(BOOST_ROOT))
    endif
endif

# Sylvan, with Lace, installed by its CMake: its headers and its libraries,
# and the object of the symbolic searches; without it they are left out
ifneq ($(wildcard $(SYLVAN_ROOT)/include/sylvan.h),)
    PBeFSSYLDEF = -DPBEFS_HAS_SYLVAN
    PBeFSSYLINC = -isystem $(SYLVAN_ROOT)/include
    PBeFSSYMOBJ = $(PBeFSSDR)/obj/Bdd.o
    PBeFSSYMLIB = -L$(SYLVAN_ROOT)/lib -lsylvan -llace \
	$(if $(filter Linux,$(UNAME_S)),-lm)
endif

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append the external -I directives to PBeFSINC as defined by the
# makefile, thus the := assignment has to be used (use GNU make)
PBeFSINC := $(PBeFSINC) $(PBeFSADSINC) $(PBeFSFFINC) $(PBeFSBOOSTINC)
PBeFSDEF = -DPBEFS_HAS_OPENMP $(PBeFSOMPSW) $(PBeFSFFDEF)

# external libraries for PBeFS
PBeFSLIB = -pthread $(PBeFSADSLIB) $(PBeFSOMPLIB)

############################# End of makefile-c ###############################
