#!/usr/bin/make -f

# the tests are built and run unless nocheck is asked; FastFlow, which
# would be downloaded at configure time, and MPI are left out
ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
PBEFS_TESTS = OFF
else
PBEFS_TESTS = ON
endif

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DPBEFS_BUILD_TESTS=$(PBEFS_TESTS) \
	                     -DBUILD_TESTING=$(PBEFS_TESTS) \
	                     -DPBEFS_BUILD_EXAMPLES=OFF \
	                     -DPBEFS_BUILD_TOOLS=OFF \
	                     -DPBEFS_WITH_FASTFLOW=OFF \
	                     -DPBEFS_WITH_MPI=OFF

# the README goes to the documentation of the package, the LICENSE is in
# debian/copyright
override_dh_auto_install:
	dh_auto_install
	rm -rf debian/libpbefs-dev/usr/share/PBeFS
