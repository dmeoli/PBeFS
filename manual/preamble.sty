% --------------------------------------------------------------------------- %
%    preamble.sty                                                             %
%                                                                             %
%    The packages and the macros of the manual of PBeFS: the mathematics,     %
%    the theorem-like environments, the pictures of TikZ, the pseudocode of   %
%    algpseudocode, the listings of C++ that manual/snarf.py extracts from    %
%    the headers, the tables of manual/tables.py, the exercises with the      %
%    test that checks each one, and the bibliography of biblatex.             %
%                                                                             %
%                                Donato Meoli                                 %
%                         Dipartimento di Informatica                         %
%                             Università di Pisa                              %
% --------------------------------------------------------------------------- %
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/11/13 the preamble of the manual of PBeFS]

% ----- fonts and page ------------------------------------------------------ %
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage[a4paper,margin=30mm]{geometry}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}

% ----- mathematics --------------------------------------------------------- %
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}

% ----- pictures, pseudocode, code and tables -------------------------------- %
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,calc,matrix,fit,shapes.geometric,
                backgrounds}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{listings}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{caption}

% ----- bibliography and references ----------------------------------------- %
\RequirePackage[backend=biber,style=numeric,sorting=none,maxbibnames=10,
                giveninits=true]{biblatex}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[capitalize,nameinlink]{cleveref}

% ----- theorem-like environments, numbered within the chapter --------------- %
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}
\crefname{lemma}{Lemma}{Lemmas}
\crefname{proposition}{Proposition}{Propositions}
\crefname{algorithm}{Algorithm}{Algorithms}
\crefname{exercise}{Exercise}{Exercises}

% ----- the exercises, each with the ctest that checks it -------------------- %
% \begin{exercise}[<test>] ... \end{exercise} prints the name of the case
% of test/tests.txt whose ctest PBeFS.<test> checks the solution
\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}
\newenvironment{exercise}[1][]{%
  \par\addvspace{\medskipamount}\refstepcounter{exercise}%
  \noindent\textbf{Exercise~\theexercise.}%
  \def\pbefs@test{#1}%
  \ifx\pbefs@test\@empty\else\ (Checked by \texttt{ctest -R PBeFS.#1}.)\fi
  \ }{\par\addvspace{\medskipamount}}

% ----- the notation --------------------------------------------------------- %
\newcommand{\PBeFS}{PBeFS}
\newcommand{\OPEN}{\textsc{Open}}
\newcommand{\CLOSED}{\textsc{Closed}}
\newcommand{\code}[1]{\texttt{#1}}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\newcommand{\N}{\mathbb{N}}
\newcommand{\R}{\mathbb{R}}

% ----- the pseudocode, as the one of the headers ----------------------------- %
% the keywords of algpseudocode, the comments starting with a triangle, and
% the names of the lists in small capitals
\algrenewcommand\algorithmiccomment[1]{\hfill$\triangleright$ #1}
\algnewcommand\algorithmicforeach{\textbf{for each}}
\algdef{S}[FOR]{ForEach}[1]{\algorithmicforeach\ #1\ \algorithmicdo}
\algnewcommand{\Continue}{\textbf{continue}}
\algnewcommand{\Break}{\textbf{break}}
\algnewcommand{\Lock}[1]{\textbf{lock} #1}
\algnewcommand{\Unlock}[1]{\textbf{unlock} #1}
\algnewcommand{\Send}[2]{\textbf{send} #1 \textbf{to} #2}

% ----- the listings of C++, extracted from the headers ----------------------- %
\lstdefinestyle{pbefs}{
  language=C++, basicstyle=\ttfamily\small, columns=fullflexible,
  keepspaces=true, keywordstyle=\bfseries, commentstyle=\itshape,
  showstringspaces=false, frame=lines, xleftmargin=1em, framexleftmargin=1em,
  numbers=none, tabsize=2, upquote=true, breaklines=true,
  literate={à}{{\`a}}1 {è}{{\`e}}1 {é}{{\'e}}1 {ö}{{\"o}}1
           {≤}{{$\le$}}1 {≥}{{$\ge$}}1 {≠}{{$\ne$}}1 {←}{{$\leftarrow$}}1}
\lstset{style=pbefs}
% \snippet{<name>} prints the code between the markers //! [<name>] of a
% header, which manual/snarf.py writes to generated/snippets/<name>.cpp;
% the optional argument is the caption
\newcommand{\snippet}[2][]{%
  \lstinputlisting[style=pbefs,title={#1}]{generated/snippets/#2.cpp}}

% ----- the tables of the benchmarks ---------------------------------------- %
% \benchtable{<name>} inputs generated/tables/<name>.tex, written by
% manual/tables.py from the CSV of tools/bench/campaign.sh
\newcommand{\benchtable}[1]{\input{generated/tables/#1}}

% ----- the figures ---------------------------------------------------------- %
% the styles shared by every picture [see manual/STYLE.md]
\tikzset{
  >={Stealth[length=2mm]},
  state/.style={draw, circle, minimum size=7mm, inner sep=0pt, font=\small},
  open/.style={state, fill=white},
  closed/.style={state, fill=black!15},
  goal/.style={state, double},
  current/.style={state, very thick},
  edge/.style={->, thin},
  list/.style={draw, rectangle, minimum height=6mm, inner sep=2pt,
               font=\small},
  msg/.style={->, dashed},
  worker/.style={draw, rounded corners, inner sep=4pt},
  lbl/.style={font=\footnotesize},
}

\endinput
