###############################################################################
######################## makefile-default-paths-macos #########################
###############################################################################
#                                                                             #
#   default paths of the external libraries on macOS                          #
#                                                                             #
#   Gives the macros of the directories of the external libraries that the    #
#   makefiles need, set to where they usually are; each one is set only if    #
#   it is not set already, on the command line or in the environment, and     #
#   makefile-paths, next to this file and ignored by git, may set it          #
#   otherwise for the libraries that are somewhere else.                      #
#                                                                             #
#   Output: $(FF_ROOT)    = the directory of the ff/ headers of FastFlow      #
#           $(ADSSDR)     = the directory of ADS (its headers in include/)    #
#           $(BOOST_ROOT) = the prefix of Boost (its headers in include/)     #
#           $(OMP_ROOT)   = the prefix of the OpenMP runtime of clang,        #
#                           empty when the compiler finds it alone            #
#                                                                             #
#                                Donato Meoli                                 #
#                         Dipartimento di Informatica                         #
#                             Universita' di Pisa                             #
#                                                                             #
###############################################################################

FF_ROOT ?= /opt/fastflow
ADSSDR ?= /opt/ADS
BOOST_ROOT ?= /opt/homebrew
OMP_ROOT ?= /opt/homebrew/opt/libomp

##################### End of makefile-default-paths-macos #####################
